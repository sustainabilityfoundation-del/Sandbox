{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ews.example/schemas/ews-cad/1.0.0/document.json",
  "title": "ews-cad native parametric CAD document, format 1.x",
  "description": "Open, versioned native model of the CAD Modeler. Stores design intent (parts, parameters, sketches, constraints, features, semantics, references); geometry is regenerated from it. Specification: docs/modules/cad/native-format.md. Referential rules (unique IDs, references to earlier sketches, constraint signatures) are checked by validateDocument in @ews/cad-core in addition to this schema.",
  "type": "object",
  "required": ["format", "formatVersion", "documentId", "version", "nextId", "units", "metadata", "parts", "references"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "ews-cad" },
    "formatVersion": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "documentId": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 0 },
    "nextId": { "type": "integer", "minimum": 1 },
    "units": {
      "type": "object",
      "required": ["length", "angle"],
      "additionalProperties": false,
      "properties": { "length": { "const": "mm" }, "angle": { "const": "deg" } }
    },
    "metadata": { "$ref": "#/$defs/metadata" },
    "parts": { "type": "array", "items": { "$ref": "#/$defs/part" } },
    "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "assemblies": { "type": "array", "maxItems": 0, "description": "Reserved for assemblies (later format version)." },
    "configurations": { "type": "array", "maxItems": 0, "description": "Reserved for configurations (later format version)." },
    "extensions": { "type": "object", "description": "Namespaced extension data; readers preserve and otherwise ignore it." }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "expr": {
      "description": "A number in document units (mm, deg) or an expression over part parameters.",
      "oneOf": [{ "type": "number" }, { "type": "string", "minLength": 1, "maxLength": 500 }]
    },
    "scalarMap": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "metadata": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" },
        "modifiedAt": { "type": "string" },
        "writer": { "type": "object", "required": ["tool", "version"], "properties": { "tool": { "type": "string" }, "version": { "type": "string" } }, "additionalProperties": false },
        "properties": { "$ref": "#/$defs/scalarMap" }
      }
    },
    "part": {
      "type": "object",
      "required": ["id", "name", "parameters", "features", "semantics"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } },
        "material": { "type": "object", "required": ["name", "density"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "density": { "type": "number", "exclusiveMinimum": 0 } } },
        "semantics": { "type": "array", "items": { "$ref": "#/$defs/semantic" } },
        "properties": { "$ref": "#/$defs/scalarMap" }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["id", "name", "expression", "unit"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
        "expression": { "type": "string", "minLength": 1, "maxLength": 500 },
        "unit": { "enum": ["mm", "deg", "none"] },
        "description": { "type": "string" }
      }
    },
    "semantic": {
      "type": "object",
      "required": ["id", "kind", "name", "targets"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["interface", "functional-surface", "design-intent", "note"] },
        "name": { "type": "string" },
        "targets": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "description": { "type": "string" }
      }
    },
    "reference": {
      "type": "object",
      "required": ["id", "subject", "role", "target"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subject": { "type": "string", "minLength": 1 },
        "role": { "enum": ["represents", "satisfies", "verifies", "realizes", "traces", "related"] },
        "target": {
          "type": "object",
          "required": ["module", "id"],
          "additionalProperties": false,
          "properties": {
            "module": { "enum": ["twin", "requirements", "sysml", "conceptualize", "external"] },
            "id": { "type": "string", "minLength": 1 },
            "revision": { "type": "integer", "minimum": 0 },
            "kind": { "type": "string" },
            "label": { "type": "string" }
          }
        }
      }
    },
    "feature": {
      "oneOf": [{ "$ref": "#/$defs/sketch" }, { "$ref": "#/$defs/extrude" }, { "$ref": "#/$defs/revolve" }]
    },
    "operation": { "enum": ["new", "join", "cut"] },
    "sketch": {
      "type": "object",
      "required": ["id", "type", "name", "plane", "entities", "constraints"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "sketch" },
        "name": { "type": "string" },
        "suppressed": { "type": "boolean" },
        "plane": {
          "type": "object",
          "required": ["kind", "plane"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "standard" }, "plane": { "enum": ["XY", "XZ", "YZ"] }, "offset": { "$ref": "#/$defs/expr" } }
        },
        "entities": { "type": "array", "items": { "$ref": "#/$defs/sketchEntity" } },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } }
      }
    },
    "sketchEntity": {
      "oneOf": [
        { "type": "object", "required": ["id", "type", "x", "y"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "point" }, "x": { "type": "number" }, "y": { "type": "number" }, "construction": { "type": "boolean" } } },
        { "type": "object", "required": ["id", "type", "start", "end"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "line" }, "start": { "type": "string" }, "end": { "type": "string" }, "construction": { "type": "boolean" } } },
        { "type": "object", "required": ["id", "type", "center", "radius"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "circle" }, "center": { "type": "string" }, "radius": { "type": "number", "exclusiveMinimum": 0 }, "construction": { "type": "boolean" } } },
        { "type": "object", "required": ["id", "type", "center", "start", "end"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "arc" }, "center": { "type": "string" }, "start": { "type": "string" }, "end": { "type": "string" }, "construction": { "type": "boolean" } } }
      ]
    },
    "constraint": {
      "type": "object",
      "required": ["id", "type", "entities"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": ["coincident", "horizontal", "vertical", "parallel", "perpendicular", "equal", "fixed", "point-on-line", "point-on-circle", "midpoint", "tangent", "concentric", "distance", "distance-x", "distance-y", "length", "radius", "diameter", "angle"]
        },
        "entities": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 2 },
        "value": { "$ref": "#/$defs/expr" },
        "driving": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "extrude": {
      "type": "object",
      "required": ["id", "type", "name", "sketch", "extent", "operation"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "extrude" },
        "name": { "type": "string" },
        "suppressed": { "type": "boolean" },
        "sketch": { "$ref": "#/$defs/id" },
        "extent": {
          "type": "object",
          "required": ["distance", "direction"],
          "additionalProperties": false,
          "properties": { "distance": { "$ref": "#/$defs/expr" }, "direction": { "enum": ["normal", "reverse", "symmetric"] } }
        },
        "operation": { "$ref": "#/$defs/operation" },
        "target": { "$ref": "#/$defs/id" }
      }
    },
    "revolve": {
      "type": "object",
      "required": ["id", "type", "name", "sketch", "axis", "angle", "operation"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "revolve" },
        "name": { "type": "string" },
        "suppressed": { "type": "boolean" },
        "sketch": { "$ref": "#/$defs/id" },
        "axis": { "type": "string", "minLength": 1 },
        "angle": { "$ref": "#/$defs/expr" },
        "operation": { "$ref": "#/$defs/operation" },
        "target": { "$ref": "#/$defs/id" }
      }
    }
  }
}
