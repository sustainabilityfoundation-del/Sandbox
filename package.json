{
  "name": "engineering-platform",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Engineering workspace platform with independently developed tools, plus a standalone GLB viewer.",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:workspace": "npm run dev -w @ews/workspace",
    "dev:viewer": "npm run dev -w @ews/glb-viewer",
    "dev:requirements": "npm run dev -w @ews/tool-requirements",
    "dev:sysml": "npm run dev -w @ews/tool-sysml",
    "dev:cad": "npm run dev -w @ews/tool-cad",
    "build": "npm run typecheck && npm run build -w @ews/glb-viewer && npm run build -w @ews/workspace",
    "build:harnesses": "npm run build:harness --workspaces --if-present",
    "preview": "vite preview",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "dev:api": "tsx services/api/src/main.ts",
    "db:up": "tsx services/api/scripts/db.ts up",
    "db:migrate": "tsx services/api/scripts/db.ts migrate",
    "db:seed": "tsx services/api/scripts/db.ts seed",
    "db:reset": "tsx services/api/scripts/db.ts reset",
    "db:status": "tsx services/api/scripts/db.ts status",
    "req:test:db": "vitest run --config services/api/vitest.db.config.ts",
    "req:reqif:schemas": "tsx packages/reqif/scripts/fetch-schemas.ts",
    "req:reqif:samples": "tsx packages/reqif/scripts/fetch-samples.ts",
    "concept:test:db": "vitest run --config services/conceptualize/vitest.db.config.ts",
    "concept:dev": "npm run dev -w @ews/tool-conceptualize",
    "cad:commands": "tsx packages/cad-core/scripts/write-catalog.ts",
    "cad:test": "vitest run packages/cad-core packages/cad-kernel packages/tool-cad-modeler",
    "cad:bench": "tsx packages/cad-kernel/scripts/bench.ts",
    "cad:dev": "npm run dev -w @ews/tool-cad-modeler"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.4"
  }
}
