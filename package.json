{
  "name": "engineering-platform",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Engineering workspace platform with independently developed tools, plus a standalone GLB viewer.",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ews/workspace",
    "dev:viewer": "npm run dev -w @ews/glb-viewer",
    "dev:requirements": "npm run dev -w @ews/tool-requirements",
    "dev:sysml": "npm run dev -w @ews/tool-sysml",
    "dev:cad": "npm run dev -w @ews/tool-cad",
    "build": "npm run typecheck && npm run build -w @ews/glb-viewer && npm run build -w @ews/workspace",
    "build:harnesses": "npm run build:harness --workspaces --if-present",
    "preview": "vite preview",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.4"
  }
}
