{
  "name": "solidworks-glb-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based viewer for GLB models exported from SolidWorks.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "generate:sample": "node scripts/generate-sample.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "~0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "~0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.4"
  }
}
