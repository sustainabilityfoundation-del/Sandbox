# Copy to .env (gitignored). No secrets here: values are for a local development machine only.

# PostgreSQL mode:
#   embedded  — start official PostgreSQL binaries from npm (embedded-postgres); no Docker needed (default)
#   external  — connect to DATABASE_URL (Docker Compose: docker compose up -d db)
EWS_PG=embedded
EWS_DB_NAME=ews_dev
# Embedded mode
EMBEDDED_PG_PORT=54329
EMBEDDED_PG_DIR=.data/pg
EMBEDDED_PG_USER=postgres
EMBEDDED_PG_PASSWORD=local-dev-only
# External mode (Docker Compose defaults)
DATABASE_URL=postgres://ews:local-dev-only@127.0.0.1:5432/ews_dev
POSTGRES_PASSWORD=local-dev-only

# API host
API_HOST=127.0.0.1
API_PORT=8787
# Seed an empty database on start (development only)
SEED_ON_START=true
# Object storage for imports, exports and attachments (local filesystem adapter)
STORAGE_DIR=.data/objects
# NODE_ENV=production refuses X-Dev-User development identities
NODE_ENV=development
REQIF_SCHEMA_DIR=.data/reqif-schemas
# Retention of delivered change events for SSE resume (hours)
OUTBOX_RETENTION_HOURS=168

# AI (ADR-0080, docs/modules/ai-interface/orchestration.md). Read on the server only; never put a key in a client or commit it.
#   (unset)      — default "user" mode: people's own connections (API key or Sign in with ChatGPT), as before. Developer keys are not read.
#   mock         — explicit. No credentials; scripted mock personas; every real source is off, including stored connections.
#                  EWS_ASSISTANT_FAKE_PROVIDER=1 is an alias. Automated and end-to-end runs set this (npm run ai:dev:fake does).
#   development  — explicit. Real models with the provider keys below (read only in this mode and never in production), meter-only
#                  billing: usage and estimated cost are recorded, nothing is charged to a person. Without any key: user mode.
# EWS_AI_MODE=
# Developer keys (development mode). A key for a provider without an adapter yet is reported as "adapter pending", never called.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_AI_API_KEY is an alias for GEMINI_API_KEY
XAI_API_KEY=
# One monthly cap across providers, in USD (also set caps in each provider's console: balances cannot be read)
EWS_AI_MONTHLY_DEV_BUDGET_USD=25
# balanced | economy | quality (the default for people who have not chosen)
EWS_AI_DEFAULT_OPTIMIZATION=balanced
# Use prices nobody has reviewed yet, shown as "unverified estimate" (default 1 in development, 0 in production)
# EWS_AI_ALLOW_UNVERIFIED_PRICING=1

# Deployment switches (docs/infrastructure/DEPLOYMENT_AUDIT.md §7). Leave unset for local development.
# A deployed process (NODE_ENV=production or EWS_DEPLOYED=1) refuses EWS_PG=embedded and a missing DATABASE_URL.
# EWS_DEPLOYED=1
# Deployed instances refuse the X-Dev-User header unless this is set (prototype behind an access gate only; logs a warning).
# EWS_ALLOW_DEV_IDENTITIES=1
# Public origin people use (behind a proxy), e.g. https://example.org. Same-origin deployment needs no CORS.
# EWS_PUBLIC_ORIGIN=
